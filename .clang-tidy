# Disabled on purpose:
#   misc-const-correctness       style only; the codebase doesn't const every local
#   misc-no-recursion            BucketPage::compact() -> insert() is intentional and bounded
#   bugprone-empty-catch         destructors deliberately swallow flush errors
#   bugprone-exception-escape    only fires for allocation failure paths
#   bugprone-signed-bitwise      integer promotion in the byte-packing helpers is safe
#   bugprone-random-generator-seed  tests use a fixed seed to stay reproducible
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-empty-catch,
  -bugprone-exception-escape,
  -bugprone-signed-bitwise,
  -bugprone-random-generator-seed,
  clang-analyzer-*,
  performance-*,
  misc-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  readability-else-after-return,
  readability-redundant-*
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
